# Gemini API Key (Vercel Environment Variable: GEMINI_API_KEY)
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Google Drive API Configuration (Required in config.js for Frontend)
# Obtain from: https://console.cloud.google.com/
DRIVE_CLIENT_ID=your_google_drive_client_id_here
DRIVE_API_KEY=your_google_drive_api_key_here
